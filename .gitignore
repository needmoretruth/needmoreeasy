# Cargo build output
/target/

# Rust tooling artifacts
**/*.rs.bk
*.pdb
rustc-ice-*.txt
**/mutants.out*/

# Python bytecode that may be created while inspecting generated programs
__pycache__/
*.py[cod]

# Local editor files
/.idea/
/.vscode/
*.swp
*.swo
*~

# Operating-system metadata
.DS_Store
Thumbs.db

# Cargo.lock is intentionally tracked: NME ships a CLI application and
# reproducible dependency resolution matters.
