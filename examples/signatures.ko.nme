# 서명 — 메시지를 쓴 사람 증명하기
# 학습용입니다: hmac으로 서명이 어떻게 만들어지고 확인되는지 보여 줍니다.
# 실제 코인은 cryptography 라이브러리의 공개키 서명을 사용합니다.
# 이 프로젝트는 투자 조언이 아닙니다.
# 실행: nme r signatures.ko

import hmac
import hashlib

secret = "공유-비밀-키"
message = "민수에게 10 지불"


def sign(text):
    return hmac.new(secret.encode(), text.encode(), hashlib.sha256).hexdigest()


signature = sign(message)
말해 "메시지: " + message
말해 "서명: " + signature[:16] + "..."

말해 "올바른 서명 검증: " + str(hmac.compare_digest(sign(message), signature))

tampered = "민수에게 100 지불"
말해 "바뀐 메시지 검증: " + str(hmac.compare_digest(sign(tampered), signature))

말해 "틀린 키로는 위조 불가: " + str(
    hmac.compare_digest(
        hmac.new("틀린-키".encode(), message.encode(), hashlib.sha256).hexdigest(),
        signature,
    )
)
