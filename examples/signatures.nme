# Signatures — proving who wrote a message
# Educational only: hmac shows how a signature is made and checked.
# Real coins use public-key signatures from a cryptography library.
# This is a learning project, not investment advice.
# Run: nme r signatures

import hmac
import hashlib

secret = "shared-secret-key"
message = "pay Mina 10"


def sign(text):
    return hmac.new(secret.encode(), text.encode(), hashlib.sha256).hexdigest()


signature = sign(message)
show "message: " + message
show "signature: " + signature[:16] + "..."

show "signed message verifies: " + str(hmac.compare_digest(sign(message), signature))

tampered = "pay Mina 100"
show "tampered message verifies: " + str(hmac.compare_digest(sign(tampered), signature))

show "a wrong key cannot forge it: " + str(
    hmac.compare_digest(
        hmac.new("wrong-key".encode(), message.encode(), hashlib.sha256).hexdigest(),
        signature,
    )
)
