# 니드모어코인 — 고급 한국어 NME
# 고급 NME는 일반 Python과 문법이 같습니다. 이 파일은 Python으로도 그대로 실행됩니다.
# 실행: nme r cryptocurrency-advanced.ko

import hashlib
import secrets

영지식큰소수 = int(
    "FFFFFFFFFFFFFFFFC90FDAA22168C234C4C6628B80DC1CD129024E088A67CC74020BBEA63B139B2251"
    "4A08798E3404DDEF9519B3CD3A431B302B0A6DF25F14374FE1356D6D51C245E485B576625E7EC6F44C42"
    "E9A637ED6B0BFF5CB6F406B7EDEE386BFB5A899FA5AE9F24117C4B1FE649286651ECE45B3DC2007CB8A163"
    "BF0598DA48361C55D39A69163FA8FD24CF5F83655D23DCA3AD961C62F356208552BB9ED529077096966D670"
    "C354E4ABC9804F1746C08CA18217C32905E462E36CE3BE39E772C180E86039B2783A2EC07A28FB5C55DF06F4"
    "C52C9DE2BCBF6955817183995497CEA956AE515D2261898FA051015728E5A8AAAC42DAD33170D04507A33A8552"
    "1ABDF1CBA64ECFB850458DBEF0A8AEA71575D060C7DB3970F85A6E1E4C7ABF5AE8CDB0933D71E8C94E04A256"
    "19DCEE3D2261AD2EE6BF12FFA06D98A0864D87602733EC86A64521F2B18177B200CBBE117577A615D6C770988"
    "C0BAD946E208E24FA074E5AB3143DB5BFCE0FD108E4B82D120A93AD2CAFFFFFFFFFFFFFFFF",
    16,
)
영지식부분군크기 = (영지식큰소수 - 1) // 2
영지식생성원 = 2
영지식그룹바이트 = (영지식큰소수.bit_length() + 7) // 8
작업목표 = 2**252
채굴보상 = 10
거래수수료 = 1


def 정수바이트(값):
    return int(값).to_bytes(영지식그룹바이트, "big")


def 문맥바이트(문맥):
    내용 = str(문맥).encode("utf-8")
    return len(내용).to_bytes(8, "big") + 내용


def 도전값(공개값, 약속값, 문맥):
    재료 = (
        b"NME-SCHNORR-GROUP15-NIZK-v1\0"
        + 정수바이트(영지식생성원)
        + 정수바이트(약속값)
        + 정수바이트(공개값)
        + 문맥바이트(문맥)
    )
    return int.from_bytes(hashlib.sha256(재료).digest(), "big")


def 비밀만들기():
    return secrets.randbelow(영지식부분군크기 - 1) + 1


def 주소만들기(비밀값):
    return pow(영지식생성원, 비밀값, 영지식큰소수)


def 서명하기(비밀값, 문맥):
    일회값 = secrets.randbelow(영지식부분군크기)
    약속값 = pow(영지식생성원, 일회값, 영지식큰소수)
    공개값 = 주소만들기(비밀값)
    도전 = 도전값(공개값, 약속값, 문맥)
    응답 = (일회값 - 비밀값 * 도전) % 영지식부분군크기
    return [약속값, 응답]


def 서명검증(공개값, 증명, 문맥):
    if not isinstance(증명, (list, tuple)) or len(증명) != 2:
        return False
    약속값, 응답 = 증명
    도전 = 도전값(공개값, 약속값, 문맥)
    return (
        1 < 공개값 < 영지식큰소수
        and pow(공개값, 영지식부분군크기, 영지식큰소수) == 1
        and 1 <= 약속값 < 영지식큰소수
        and pow(약속값, 영지식부분군크기, 영지식큰소수) == 1
        and 0 <= 응답 < 영지식부분군크기
        and 약속값
        == (
            pow(영지식생성원, 응답, 영지식큰소수)
            * pow(공개값, 도전, 영지식큰소수)
        )
        % 영지식큰소수
    )


def 채굴(채굴자주소, 문맥):
    시도 = 0
    while True:
        일회값 = secrets.randbelow(영지식부분군크기)
        약속값 = pow(영지식생성원, 일회값, 영지식큰소수)
        해시 = 도전값(채굴자주소, 약속값, 문맥)
        시도 += 1
        if 해시 < 작업목표:
            return 약속값, 해시, 시도


def 블록검증(채굴자주소, 문맥, 약속값, 해시):
    return 해시 < 작업목표 and 도전값(채굴자주소, 약속값, 문맥) == 해시


민수비밀 = 비밀만들기()
지수비밀 = 비밀만들기()
채굴자비밀 = 비밀만들기()
민수주소 = 주소만들기(민수비밀)
지수주소 = 주소만들기(지수비밀)
채굴자주소 = 주소만들기(채굴자비밀)

잔액 = {민수주소: 100, 지수주소: 0, 채굴자주소: 0}
사용번호 = {민수주소: 0, 지수주소: 0}
총발행량 = 100

창세문맥 = f"니드모어코인|창세|{민수주소}|100"
창세약속, 창세해시, 창세시도 = 채굴(채굴자주소, 창세문맥)
창세블록 = {
    "높이": 0,
    "이전해시": 0,
    "문맥": 창세문맥,
    "약속": 창세약속,
    "해시": 창세해시,
}
print(f"창세 블록 채굴 완료: {창세시도}회")

거래금액 = 25
거래번호 = 1
거래문맥 = f"{민수주소}|{지수주소}|{거래금액}|{거래수수료}|{거래번호}"
거래증명 = 서명하기(민수비밀, 거래문맥)
거래승인 = (
    서명검증(민수주소, 거래증명, 거래문맥)
    and 거래금액 > 0
    and 잔액[민수주소] >= 거래금액 + 거래수수료
    and 거래번호 == 사용번호[민수주소] + 1
)
if not 거래승인:
    raise RuntimeError("정상 거래가 거부되었습니다")

잔액[민수주소] -= 거래금액 + 거래수수료
잔액[지수주소] += 거래금액
사용번호[민수주소] = 거래번호

블록문맥 = (
    f"니드모어코인|1|이전={창세해시}|거래={거래문맥}|증명={거래증명}|"
    f"채굴자={채굴자주소}|보상={채굴보상}"
)
블록약속, 블록해시, 블록시도 = 채굴(채굴자주소, 블록문맥)
블록하나 = {
    "높이": 1,
    "이전해시": 창세해시,
    "문맥": 블록문맥,
    "약속": 블록약속,
    "해시": 블록해시,
    "거래": 거래문맥,
    "증명": 거래증명,
}
잔액[채굴자주소] += 채굴보상 + 거래수수료
총발행량 += 채굴보상
print(f"블록 1 채굴 완료: {블록시도}회")

사슬검증 = (
    블록검증(채굴자주소, 창세블록["문맥"], 창세블록["약속"], 창세블록["해시"])
    and 블록하나["이전해시"] == 창세블록["해시"]
    and 블록검증(채굴자주소, 블록하나["문맥"], 블록하나["약속"], 블록하나["해시"])
    and 서명검증(민수주소, 블록하나["증명"], 블록하나["거래"])
    and sum(잔액.values()) == 총발행량
)
print("전체 블록 사슬 검증:", 사슬검증)

변조문맥 = f"{민수주소}|{지수주소}|250|{거래수수료}|{거래번호}"
print("변조된 거래의 기존 서명:", 서명검증(민수주소, 거래증명, 변조문맥))
변조블록문맥 = 블록문맥.replace(거래문맥, 변조문맥)
print("변조된 블록의 기존 해시:", 도전값(채굴자주소, 블록약속, 변조블록문맥) == 블록해시)
print("오래된 거래번호 재전송:", 거래번호 == 사용번호[민수주소] + 1)
print("민수 잔액:", 잔액[민수주소])
print("지수 잔액:", 잔액[지수주소])
print("채굴자 잔액:", 잔액[채굴자주소])
print("총 발행량:", 총발행량)
