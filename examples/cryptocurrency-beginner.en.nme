# NeedMoreCoin — beginner English NME
# Same cryptocurrency as the sentence reference, written with compact beginner forms.
# Run: nme r cryptocurrency-beginner.en

use zeroknowledge latest

set coinname to NeedMoreCoin
set difficulty to 4
set target to 7237005577332262213973186563042994240829374041602535252466099000494570602496
set miningreward to 10
set transactionfee to 1
set totalsupply to 100

set alicesecret to zero knowledge secret make
set aliceaddress to alicesecret zero knowledge public make
set bobsecret to zero knowledge secret make
set bobaddress to bobsecret zero knowledge public make
set minersecret to zero knowledge secret make
set mineraddress to minersecret zero knowledge public make

set alicebalance to 100
set bobbalance to 0
set minerbalance to 0
set alicenonce to 0

say "NeedMoreCoin starts"
say difficulty

set genesiscontext to coinname genesis block gives aliceaddress 100 coins
set genesistries to 0
set genesiscommitment to 0
set genesishash to 0
65536 times:
    set genesisnonce to zero knowledge nonce make
    set genesiscandidatecommitment to genesisnonce zero knowledge commitment make
    set genesishashcandidate to mineraddress genesiscandidatecommitment genesiscontext zero knowledge challenge make
    set genesistries to genesistries + 1
    when genesishashcandidate < target:
        set genesiscommitment to genesiscandidatecommitment
        set genesishash to genesishashcandidate
        break

say "Genesis block mined"
say genesistries

set transactionamount to 25
set transactionnonce to 1
set expectednonce to alicenonce + 1
set neededbalance to transactionamount + transactionfee
set transactioncontext to aliceaddress sends transactionamount coins to bobaddress fee transactionfee nonce transactionnonce
set transactionproof to alicesecret transactioncontext zero knowledge proof make
set signaturevalid to aliceaddress transactionproof transactioncontext zero knowledge verify
set transactionaccepted to false
when signaturevalid:
    when transactionamount > 0:
        when alicebalance >= neededbalance:
            when transactionnonce == expectednonce:
                set transactionaccepted to true

when transactionaccepted:
    set alicebalance to alicebalance - transactionamount
    set alicebalance to alicebalance - transactionfee
    set bobbalance to bobbalance + transactionamount
    set alicenonce to transactionnonce

set blockcontext to coinname block one previous genesishash transaction transactioncontext proof transactionproof miner mineraddress reward miningreward
set blocktries to 0
set blockcommitment to 0
set blockhash to 0
65536 times:
    set blocknonce to zero knowledge nonce make
    set blockcandidatecommitment to blocknonce zero knowledge commitment make
    set blockhashcandidate to mineraddress blockcandidatecommitment blockcontext zero knowledge challenge make
    set blocktries to blocktries + 1
    when blockhashcandidate < target:
        set blockcommitment to blockcandidatecommitment
        set blockhash to blockhashcandidate
        break

when transactionaccepted:
    set minerbalance to minerbalance + miningreward + transactionfee
    set totalsupply to totalsupply + miningreward

say "Block one mined"
say blocktries

set checktransactioncontext to aliceaddress sends transactionamount coins to bobaddress fee transactionfee nonce transactionnonce
set checksignature to aliceaddress transactionproof checktransactioncontext zero knowledge verify
set checkgenesiscontext to coinname genesis block gives aliceaddress 100 coins
set checkgenesishash to mineraddress genesiscommitment checkgenesiscontext zero knowledge challenge make
set checkblockcontext to coinname block one previous genesishash transaction checktransactioncontext proof transactionproof miner mineraddress reward miningreward
set checkblockhash to mineraddress blockcommitment checkblockcontext zero knowledge challenge make
set balancesum to alicebalance + bobbalance + minerbalance

set chainvalid to false
when checksignature:
    when checkgenesishash == genesishash:
        when checkgenesishash < target:
            when checkblockhash == blockhash:
                when checkblockhash < target:
                    when balancesum == totalsupply:
                        set chainvalid to true

when chainvalid:
    say "Full blockchain verification succeeded"

set tamperedamount to 250
set tamperedcontext to aliceaddress sends tamperedamount coins to bobaddress fee transactionfee nonce transactionnonce
set tamperedsignaturevalid to aliceaddress transactionproof tamperedcontext zero knowledge verify
set tamperedblockcontext to coinname block one previous genesishash transaction tamperedcontext proof transactionproof miner mineraddress reward miningreward
set tamperedblockhash to mineraddress blockcommitment tamperedblockcontext zero knowledge challenge make
when not tamperedsignaturevalid:
    say "Signature rejected the changed transaction amount"
when tamperedblockhash != blockhash:
    say "Block hash rejected the changed transaction amount"

set replayexpectednonce to alicenonce + 1
when transactionnonce != replayexpectednonce:
    say "Transaction nonce rejected replay of the old transaction"

say alicebalance
say bobbalance
say minerbalance
say totalsupply
when balancesum == totalsupply:
    say "Monetary supply conservation verified"
