# Python and NME live happily in one file.
# Run: nme r mixed.nme

def cheer(name):
    say f"Go, {name}!"          # NME inside a Python function

for name in ["Ada", "Grace"]:
    cheer(name)

2 times:
    say "NME block"             # NME block...
    print("python block")       # ...with Python inside
