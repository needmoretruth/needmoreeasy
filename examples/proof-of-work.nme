# Proof of work — mining blocks and verifying the chain
# This is a learning project about how a blockchain secures data,
# not investment advice.
# Run: nme r proof-of-work

use random latest

import hashlib

difficulty = 2
target = "0" * difficulty


def mine(data, previous_hash):
    nonce = 0
    while True:
        text = previous_hash + data + str(nonce)
        block_hash = hashlib.sha256(text.encode()).hexdigest()
        if block_hash.startswith(target):
            return {"data": data, "nonce": nonce, "hash": block_hash}
        nonce = nonce + 1


chain = []
previous_hash = "0"

3 times:
    block = mine("block " + str(random_number(1, 99)), previous_hash)
    chain.append(block)
    previous_hash = block["hash"]
    show f"mined {block['hash'][:14]} nonce {block['nonce']}"

show "every hash starts with " + target


def is_valid(blocks):
    previous = "0"
    for block in blocks:
        text = previous + block["data"] + str(block["nonce"])
        block_hash = hashlib.sha256(text.encode()).hexdigest()
        if not block_hash.startswith(target) or block_hash != block["hash"]:
            return False
        previous = block_hash
    return True


show "chain valid: " + str(is_valid(chain))
chain[0]["data"] = "tampered"
show "after changing the first block: " + str(is_valid(chain))
