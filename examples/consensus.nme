# Consensus — how nodes agree on the same chain
# A small simulation of miners racing and following the longest valid
# chain. Educational only: a real network adds signatures, many peers,
# and timing. This is a learning project, not investment advice.
# Run: nme r consensus

import hashlib

difficulty = 2
target = "0" * difficulty


def mine(chain, data):
    previous = chain[-1]["hash"]
    nonce = 0
    while True:
        text = previous + data + str(nonce)
        block_hash = hashlib.sha256(text.encode()).hexdigest()
        if block_hash.startswith(target):
            return {"data": data, "nonce": nonce, "hash": block_hash, "prev": previous}
        nonce = nonce + 1


def is_valid(chain):
    previous = chain[0]["hash"]
    for block in chain[1:]:
        text = previous + block["data"] + str(block["nonce"])
        block_hash = hashlib.sha256(text.encode()).hexdigest()
        if not block_hash.startswith(target) or block_hash != block["hash"]:
            return False
        previous = block_hash
    return True


genesis = {"data": "genesis", "nonce": 0, "hash": "0", "prev": ""}
node_a = [genesis]
node_b = [genesis]

show "two miners start from the genesis block"
a_block = mine(node_a, "A: block 1")
node_a.append(a_block)
show "A mined the first block: " + str(len(node_a)) + " vs " + str(len(node_b))

show "B hears about A's block and copies it"
node_b.append(a_block)
show "both nodes hold " + str(len(node_a)) + " blocks"

show "B mines a rival block on top, forking the chain"
b_block = mine(node_b, "B: rival")
node_b.append(b_block)
show "B now has " + str(len(node_b)) + " blocks, A has " + str(len(node_a))

show "A hears about the longer chain and adopts it (longest chain rule)"
node_a = list(node_b)
show "both agree: " + str(is_valid(node_a)) + " and " + str(is_valid(node_b))
