# 아주 작은 블록체인 장부 — 해시로 연결된 블록들
# 블록체인이 데이터를 저장하는 방법을 배우는 학습 프로젝트입니다.
# 투자 조언이 아닙니다.
# 실행: nme r blockchain-ledger.ko

use random latest

import hashlib

chain = []
previous_hash = "0"

3 times:
    data = "메시지 " + str(random_number(1, 99))
    combined = previous_hash + data
    block_hash = hashlib.sha256(combined.encode()).hexdigest()
    block = {"data": data, "prev": previous_hash[:8], "hash": block_hash[:8]}
    chain.append(block)
    previous_hash = block_hash
    말해 f"블록 {block['hash']} -> 이전 {block['prev']}"

말해 "연결된 블록이 " + str(len(chain)) + "개입니다"
